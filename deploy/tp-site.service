[Unit]
Description=Thinking People Next.js
After=network.target
[Service]
Type=simple
User=bsadmin
Group=bsadmin
WorkingDirectory=/home/bsadmin/runtime/tp-site
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
EnvironmentFile=/home/bsadmin/shared/tp-site/app.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
UMask=0077
[Install]
WantedBy=multi-user.target
